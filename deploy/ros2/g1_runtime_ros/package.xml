<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_runtime_ros</name>
  <version>0.2.0</version>
  <description>Thin ROS 2 Humble wrapper around humanoid_arc_bme.onboard.runtime (operator runtime + web UI for the Unitree G1). The core runs without ROS.</description>
  <maintainer email="">Czimber Mark</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- not rosdep keys (pip, see deploy/scripts/requirements-jetson.txt): unitree_sdk2py, cyclonedds==0.10.2, onnxruntime -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
